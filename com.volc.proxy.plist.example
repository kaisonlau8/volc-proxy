<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.volc.proxy</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Replace with your Python path -->
        <string>/usr/bin/python3</string>
        <string>/path/to/volc-proxy/main.py</string>
    </array>
    <key>WorkingDirectory</key>
    <!-- Replace with your project path -->
    <string>/path/to/volc-proxy</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/path/to/volc-proxy/logs/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/volc-proxy/logs/stderr.log</string>
</dict>
</plist>